# FlowBiz Sign — server environment variables (set in Vercel → Project → Settings → Environment Variables)

# ── Admin auth (IMPORTANT: set these and rotate the old password!) ──
# Comma-separated list of admin emails allowed to log in.
ADMIN_EMAILS=orias3@gmail.com,amitbens97@gmail.com
# Shared admin password. Until this is set, the historical built-in password
# still works (so a deploy never locks you out) — but it is public in the git
# history, so set a NEW value here as soon as possible.
ADMIN_PASSWORD=

# ── State encryption at rest ──
# When set (any string, 8+ chars), the shared admin state blob and all new
# backups are AES-256-GCM encrypted. Existing plaintext data keeps reading
# fine and gets re-encrypted on the next save.
# WARNING: after enabling, losing/changing this value makes the current state
# unreadable — store it somewhere safe.
STATE_SECRET=

# ── Email (Gmail app password) — used for invites, signed copies, reminders ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional "From" header override, e.g. FlowBiz Sign <noreply@flowbiz.co.il>
EMAIL_FROM=

# ── Cron protection ──
# Vercel sends this automatically as a Bearer token to /api/cron/reminders
# when the env var exists. Any random string.
CRON_SECRET=

# Provided automatically by Vercel Blob integration (do not set manually):
# BLOB_READ_WRITE_TOKEN=
